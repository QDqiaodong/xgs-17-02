# ==============================================
# Docker 构建上下文排除文件
# 避免将大量无关文件传入 Docker 构建上下文
# ==============================================

# ---------- 版本控制 ----------
.git
.gitignore
.gitattributes
.svn
.hg

# ---------- IDE / 编辑器配置 ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.swp
*.swo
*~

# ---------- 日志文件 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log.*
nohup.out
dump.rdb
*.pid
*.seed
*.pid.lock

# ---------- 后端编译产物 ----------
backend/target/
backend/build/
backend/out/
backend/*.jar
backend/*.war
backend/gradle/
*.class

# ---------- 前端编译产物 ----------
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.nuxt/
frontend/.next/
frontend/.output/

# ---------- 前端依赖 ----------
frontend/node_modules/
frontend/.npm-cache/
frontend/.yarn/
frontend/.pnpm/
frontend/pnpm-lock.yaml

# ---------- 后端依赖缓存 ----------
.gradle/
.m2/
*.iml

# ---------- 临时文件 ----------
tmp/
temp/
.cache/
.DS_Store
Thumbs.db
*.tmp
*.temp
*.bak
*.swp

# ---------- 截图/媒体资源 ----------
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
screenshots/
uploads/

# ---------- 环境变量文件（敏感信息）----------
.env.local
.env.*.local
*.env.bak

# ---------- 测试覆盖率 ----------
coverage/
.nyc_output/

# ---------- Docker 相关 ----------
docker-compose.override.yml
docker-compose.dev.override.yml
Dockerfile.bak
*.dockerignore.bak

# ---------- 构建脚本产物 ----------
build/
bin/
obj/
publish/
